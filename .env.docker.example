# Domain phải trỏ DNS về IP server. Không thêm https:// và không thêm dấu / cuối.
DOMAIN=monitor.example.com

# Chỉ dùng chữ và số cho mật khẩu DB vì giá trị này được ghép vào DATABASE_URL.
POSTGRES_DB=v_monitor
POSTGRES_USER=v_monitor
POSTGRES_PASSWORD=replace_with_output_of_openssl_rand_hex_24

# Tạo bằng: openssl rand -hex 32
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32

# Broker công cộng chỉ dùng để thử. Production phải dùng broker riêng có tài khoản và TLS.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=v_monitor/telemetry

GEOCODING_PROVIDER=photon
GEOCODING_BASE_URL=https://photon.komoot.io
GEOCODING_USER_AGENT=v_monitor/1.0
