<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme cửa sổ khi Android đang khởi động ứng dụng và hệ thống ở chế độ tối. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Hiện splash cho tới khi Flutter engine vẽ khung hình đầu tiên. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme nền cửa sổ sau khi tiến trình mở, dùng trong lúc UI Flutter khởi tạo
         và phía sau Flutter view; dành cho Android embedding V2. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
