APP_ENV=development

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/v_monitor

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false

# Reverse geocoding for local/dev. For production tracking, point this to a
# self-hosted or contracted provider with an appropriate usage policy.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=v_monitor/1.0 local-development
GEOCODING_TIMEOUT_SECONDS=8

API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

JWT_SECRET=change-me-for-local-development
