# APP_ENV đặt tên môi trường; API_PREFIX là tiền tố REST.
# API_HOST/API_PORT là địa chỉ Uvicorn lắng nghe; API_RELOAD chỉ bật khi phát triển cục bộ.
APP_ENV=development
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# CORS_ORIGINS là các origin frontend web được phép gọi API, phân tách bằng dấu phẩy.
# Khi public, thay dấu * bằng URL thật, ví dụ https://monitor.example.com.
CORS_ORIGINS=*

# DATABASE_URL chứa driver, tài khoản, host, cổng và tên PostgreSQL.
# POOL_SIZE là số kết nối thường trực; MAX_OVERFLOW là phần tăng tạm khi cao tải.
# POOL_TIMEOUT giới hạn chờ lấy kết nối; POOL_RECYCLE thay socket cũ định kỳ.
# CONNECT_TIMEOUT giới hạn thời gian thiết lập một kết nối mới.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/v_monitor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# MQTT_HOST/PORT/USERNAME/PASSWORD/TLS xác định broker và cách đăng nhập.
# MQTT_CLIENT_ID để trống sẽ tự sinh riêng cho từng máy hoặc container.
# TOPIC_PREFIX là gốc topic; KEEPALIVE kiểm tra phiên; CONNECT_TIMEOUT giới hạn bắt tay.
# RECONNECT_MIN/MAX đặt biên backoff; WORKER_COUNT và QUEUE_SIZE điều khiển tải xử lý.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=v_monitor/telemetry
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_RECONNECT_MIN_DELAY_SECONDS=1
MQTT_RECONNECT_MAX_DELAY_SECONDS=30
MQTT_WORKER_COUNT=8
MQTT_QUEUE_SIZE=20000

# REALTIME_SEND_TIMEOUT_SECONDS giới hạn thời gian gửi một bản tin tới từng frontend.
REALTIME_SEND_TIMEOUT_SECONDS=5

# PROVIDER chọn bộ phân tích Photon/Nominatim; BASE_URL là endpoint nhà cung cấp.
# USER_AGENT nhận diện ứng dụng; TIMEOUT/RETRY/DELAY điều khiển xử lý lỗi mạng.
# Khi triển khai thật, dùng máy chủ tự quản
# hoặc nhà cung cấp có chính sách phù hợp với lưu lượng theo dõi thiết bị.
GEOCODING_PROVIDER=photon
GEOCODING_BASE_URL=https://photon.komoot.io
GEOCODING_USER_AGENT=v_monitor/1.0 local-development
GEOCODING_TIMEOUT_SECONDS=8
GEOCODING_RETRY_ATTEMPTS=2
GEOCODING_RETRY_DELAY_SECONDS=0.5

# AUTH_REQUIRED bật xác thực; JWT_SECRET ký token, ALGORITHM/ISSUER/AUDIENCE xác minh nguồn.
# LOGIN_MAX_FAILED_ATTEMPTS và LOGIN_LOCK_MINUTES bảo vệ trước dò mật khẩu liên tục.
AUTH_REQUIRED=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=v_monitor
JWT_AUDIENCE=v_monitor_internal
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# OFFLINE_TIMEOUT là thời gian im lặng trước khi ngoại tuyến; SCAN_INTERVAL là chu kỳ quét.
# DEVICE_LIST_MAX_LIMIT giới hạn số thiết bị trả về trong một lần tải giao diện.
DEVICE_OFFLINE_TIMEOUT_SECONDS=300
DEVICE_OFFLINE_SCAN_INTERVAL_SECONDS=30
DEVICE_LIST_MAX_LIMIT=5000

# Các biến theo dõi dưới đây là tùy chọn và đang dùng mặc định trong Settings:
# DEFAULT_TIMEZONE=UTC: múi giờ dự phòng khi client không truyền giá trị riêng.
# TRACKING_GAP_THRESHOLD_SECONDS=300: khoảng thời gian dùng để tách đoạn hành trình.
# TRACKING_OUTLIER_SPEED_KMH=500: ngưỡng nhận diện điểm GPS nhảy bất thường.
# TRACKING_MAX_HISTORY_SAMPLES=100000: trần số mẫu của một truy vấn lịch sử.
