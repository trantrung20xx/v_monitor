# Môi trường và tiến trình HTTP. API_RELOAD chỉ bật khi phát triển cục bộ.
APP_ENV=development
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Các origin frontend được phép gọi API, phân tách bằng dấu phẩy.
# Khi public, thay dấu * bằng URL thật, ví dụ https://monitor.example.com.
CORS_ORIGINS=*

# PostgreSQL dùng driver asyncpg. Điều chỉnh pool theo giới hạn của máy chủ DB.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/v_monitor
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# MQTT_CLIENT_ID để trống sẽ tự sinh riêng cho từng máy hoặc container.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_TOPIC_PREFIX=v_monitor/telemetry
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_RECONNECT_MIN_DELAY_SECONDS=1
MQTT_RECONNECT_MAX_DELAY_SECONDS=30
MQTT_WORKER_COUNT=8
MQTT_QUEUE_SIZE=20000

# Giới hạn thời gian gửi một bản tin realtime tới từng frontend.
REALTIME_SEND_TIMEOUT_SECONDS=5

# Dịch vụ đổi tọa độ thành địa chỉ. Khi triển khai thật, dùng máy chủ tự quản
# hoặc nhà cung cấp có chính sách phù hợp với lưu lượng theo dõi thiết bị.
GEOCODING_PROVIDER=photon
GEOCODING_BASE_URL=https://photon.komoot.io
GEOCODING_USER_AGENT=v_monitor/1.0 local-development
GEOCODING_TIMEOUT_SECONDS=8
GEOCODING_RETRY_ATTEMPTS=2
GEOCODING_RETRY_DELAY_SECONDS=0.5

# Mọi API giám sát và WebSocket đều yêu cầu tài khoản nội bộ hợp lệ.
AUTH_REQUIRED=true
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=v_monitor
JWT_AUDIENCE=v_monitor_internal
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

DEVICE_OFFLINE_TIMEOUT_SECONDS=300
DEVICE_OFFLINE_SCAN_INTERVAL_SECONDS=30
DEVICE_LIST_MAX_LIMIT=5000
