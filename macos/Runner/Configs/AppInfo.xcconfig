// Metadata cấp ứng dụng cho target Runner macOS.
//
// Các giá trị này hiện được quản lý tại đây; Flutter chưa tự sinh toàn bộ từ pubspec.yaml.

// Tên sản phẩm, mặc định cũng là tiêu đề cửa sổ Flutter.
PRODUCT_NAME = v_monitor

// Bundle identifier duy nhất của ứng dụng macOS.
PRODUCT_BUNDLE_IDENTIFIER = com.iig.vmonitor.vMonitor

// Thông tin bản quyền hiển thị trong hộp thông tin ứng dụng.
PRODUCT_COPYRIGHT = Copyright © 2026 com.iig.v_monitor. All rights reserved.
